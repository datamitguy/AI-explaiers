digraph MarketRiskTaxonomy {
  graph [rankdir=LR, splines=true, nodesep=0.25, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08", width=2.2];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  MR [label="Market risk\nprices move,\nnobody defaults", fillcolor="#1f2937", fontcolor="white", color="#1f2937", width=1.6];

  subgraph cluster_f {
    label="Risk factors (what moves)"; style=dashed; color="#9ca3af"; fontcolor="#374151";
    IR [label="Interest rates\nand yield curves"];
    CS [label="Credit spreads"];
    FX [label="Foreign exchange rates"];
    EQ [label="Equity prices"];
    CO [label="Commodity prices"];
    VOL [label="Volatility\n(how jumpy prices are)"];
  }

  subgraph cluster_d {
    label="Where it mainly lives"; style=dashed; color="#9ca3af"; fontcolor="#374151";
    RD [label="Rates desk\nbonds, swaps, options"];
    CD [label="Credit trading desk\ncorporate bonds, CDS"];
    FD [label="FX desk\nspot, forwards, options"];
    ED [label="Equities desk\nshares, index options"];
    KD [label="Commodities desk\noil, metals, power"];
    OD [label="Options books\non every desk"];
    TR [label="Treasury, banking book\nIRRBB and CSRBB\n(Pillar 2, not FRTB)", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  }

  MR -> {IR CS FX EQ CO VOL};
  IR -> RD; CS -> CD; FX -> FD; EQ -> ED; CO -> KD; VOL -> OD;
  IR -> TR [style=dashed]; CS -> TR [style=dashed];
}
