digraph ScorecardsLifecycle {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Apply [label="Application\n(a stranger asks to borrow)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Live  [label="Live account\n(months and years of payments)"];
  Late  [label="Missed payment\n(account enters arrears)", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Rec   [label="Charged off\n(handed to recoveries)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_scores {
    label="Which score is used at each stage"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    AppS  [label="Application score\nbureau + form data\nquestion: will this person\ndefault in 12 to 24 months?"];
    BehS  [label="Behavioural score\nrecalculated monthly from\nhow the account is used\nquestion: is risk rising?"];
    ColS  [label="Collections score\nquestion: will this customer\npay without us chasing?"];
    RecS  [label="Recovery score\nquestion: how much will we\nget back, and by which route?"];
  }

  subgraph cluster_uses {
    label="What the score drives"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    U1 [label="Accept or decline,\nstarting limit, price", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    U2 [label="Limit increases and cuts,\ncross-sell, IRB PD pools", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    U3 [label="Who to call first,\nsoft or hard treatment", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    U4 [label="Keep in house, agency,\nlegal action or debt sale", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  }

  Apply -> Live -> Late -> Rec;
  Late -> Live [label=" cures", style=dashed, color="#065f46", fontcolor="#065f46"];
  Apply -> AppS [style=dotted];
  Live  -> BehS [style=dotted];
  Late  -> ColS [style=dotted];
  Rec   -> RecS [style=dotted];
  AppS -> U1; BehS -> U2; ColS -> U3; RecS -> U4;
  { rank=same; Apply; AppS; U1; }
  { rank=same; Live; BehS; U2; }
  { rank=same; Late; ColS; U3; }
  { rank=same; Rec; RecS; U4; }
}
