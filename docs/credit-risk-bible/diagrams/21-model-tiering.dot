digraph ModelTiering {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="Something a team calls\n'the model' or 'the tool'", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Q0 [label="Does it apply a method to inputs\nto produce an estimate\nthat drives a decision?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  NotModel [label="Not a model\n(calculator, report, lookup table)\nStill needs end-user computing controls", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  Q1 [label="Used for regulatory capital,\nprovisions or financial statements?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Q2 [label="Large exposure or\nmany customer decisions\ndepend on it?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Q3 [label="Complex method or\npoor data?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];

  T1 [label="Tier 1: highest materiality\nFull independent validation,\nannual review, committee approval,\nregulator may inspect", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  T2 [label="Tier 2: medium\nIndependent validation,\nreview every two to three years"];
  T3 [label="Tier 3: low\nLighter review, self-assessment\nby owner, periodic check", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Inv [label="Recorded in the model inventory\nowner, tier, status, next review date"];

  Start -> Q0;
  Q0 -> NotModel [label=" no"];
  Q0 -> Q1 [label=" yes"];
  Q1 -> T1 [label=" yes"];
  Q1 -> Q2 [label=" no"];
  Q2 -> Q3 [label=" yes"];
  Q2 -> T3 [label=" no"];
  Q3 -> T1 [label=" yes"];
  Q3 -> T2 [label=" no"];
  {T1 T2 T3} -> Inv;
}
