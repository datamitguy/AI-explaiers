digraph EventTypes {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7];

  Root [label="Operational risk\nloss from failed processes,\npeople, systems or\nexternal events", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_people {
    label="Mostly people"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11; labeljust=r;
    E1 [label="1. Internal fraud\nrogue trader, staff theft,\ndeliberately hidden positions"];
    E2 [label="2. External fraud\ncyber theft, forged documents,\nfake loan applications"];
    E3 [label="3. Employment practices and\nworkplace safety\ndiscrimination claims, injuries"];
    E4 [label="4. Clients, products and\nbusiness practices\nmis-selling, conduct fines"];
  }
  subgraph cluster_things {
    label="Mostly things, systems and processes"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11; labeljust=r;
    E5 [label="5. Damage to physical assets\nfire, flood, storm, terrorism"];
    E6 [label="6. Business disruption and\nsystem failures\nIT outage, failed upgrade"];
    E7 [label="7. Execution, delivery and\nprocess management\nkeying error, missed deadline"];
  }
  Root -> E1; Root -> E2; Root -> E3; Root -> E4;
  Root -> E5; Root -> E6; Root -> E7;
}
