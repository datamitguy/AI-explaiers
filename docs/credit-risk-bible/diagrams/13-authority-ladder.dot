digraph AuthorityLadder {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="New credit proposal\n(amount, rating, type)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Q1 [label="Within the local credit\nofficer's delegated authority?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Q2 [label="Within the regional or\nbusiness credit committee's\nauthority?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Q3 [label="Within the group\ncredit committee's authority?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];

  subgraph cluster_levels {
    label="Approval levels (illustrative amounts; every bank differs)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    L1 [label="Local credit officer plus\nrelationship manager (four eyes)\ne.g. up to 2m, good ratings only"];
    L2 [label="Regional credit committee\ne.g. up to 25m, or any\nweaker-rated or exception case"];
    L3 [label="Group credit committee\n(chaired by chief credit officer)\ne.g. up to 150m"];
    L4 [label="Board risk committee or board\nabove group authority, or\nany large exposure"];
  }

  Policy [label="Any policy exception,\nconnected party, or\nwatchlist name?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Bump [label="Escalate one level higher\nregardless of amount", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Record [label="Decision minuted, conditions\nand limits loaded to systems", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Start -> Policy;
  Policy -> Bump [label=" yes"];
  Policy -> Q1 [label=" no"];
  Bump -> Q1 [style=dashed];
  Q1 -> L1 [label=" yes"];
  Q1 -> Q2 [label=" no"];
  Q2 -> L2 [label=" yes"];
  Q2 -> Q3 [label=" no"];
  Q3 -> L3 [label=" yes"];
  Q3 -> L4 [label=" no"];
  {L1 L2 L3 L4} -> Record;
}
