digraph ICAAP {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.45, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="Annual ICAAP cycle begins\n(board approves scope and scenarios)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  S1 [label="1. Risk identification\ninventory of all material risks,\nnot just Pillar 1 ones"];
  S2 [label="2. Quantification\ncapital needed per risk today\n(Pillar 2A style add-ons)"];
  S3 [label="3. Capital planning\n3 to 5 year base case:\nearnings, growth, dividends, RWA"];
  S4 [label="4. Stress testing\nsevere but plausible scenarios\nplus reverse stress test"];
  S5 [label="5. Management actions\ncredible, timed, quantified\n(cut dividends, shrink book, raise AT1)"];
  Q  [label="Capital stays above\nhurdles under stress?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Fix [label="Revise plan, buffers,\nrisk appetite or strategy", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  S6 [label="6. ICAAP document\nand board challenge and sign-off"];
  S7 [label="7. Supervisory review (SREP)\nregulator sets Pillar 2\nrequirements and guidance", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Use [label="Use test: results feed risk appetite,\nlimits, pricing and strategy\nthroughout the year", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  Start -> S1 -> S2 -> S3 -> S4 -> S5 -> Q;
  Q -> Fix [label=" no"];
  Fix -> S3;
  Q -> S6 [label=" yes"];
  S6 -> S7 -> Use;
  Use -> Start [style=dashed, label=" next year"];
}
