digraph ParallelRun {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.35, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="Build tested and approved\nfor parallel running", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Run [label="Month-end: run old and new\non the same frozen data"];
  Cmp [label="Compare at total, segment\nand exposure level"];
  Exp [label="Explain every variance\nexpected (rule change) or\nunexpected (defect, data)"];
  Tol [label="Unexplained variance\nwithin tolerance?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  Fix [label="Raise defect, fix,\nre-test, reset the count", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Cnt [label="Enough clean\nmonth-ends?\n(often 2 or 3)", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  Gate [label="Go-live gate\nrisk, finance, validation,\nreporting sign; CAB approves"];
  Ready [label="Rollback tested?\nOutside freeze?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  Wait [label="Wait for the next\nrelease window", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  Cut [label="Cutover\nnew becomes official,\nold kept read-only", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  PIR [label="Post-implementation review\nafter first live reporting cycle", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Start -> Run -> Cmp -> Exp -> Tol;
  Tol -> Fix [label="no"];
  Fix -> Run [style=dashed, label="next\nmonth-end"];
  Tol -> Cnt [label="yes"];
  Cnt -> Run [style=dashed, label="no"];
  Cnt -> Gate [label="yes"];
  Gate -> Ready;
  Ready -> Wait [label="no"];
  Wait -> Ready [style=dashed];
  Ready -> Cut [label="yes"];
  Cut -> PIR;
  {rank=same; Tol Fix}
  {rank=same; Ready Wait}
}
