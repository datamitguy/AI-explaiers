digraph CreditLiq {
  graph [rankdir=TB, splines=true, nodesep=0.3, ranksep=0.45, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Event [label="Credit event\nlarge losses in a portfolio,\nor borrowers under stress", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Borrowers [label="Borrowers in trouble"];
  Bank [label="The bank's own rating\nis cut and confidence falls"];

  subgraph cluster_drains {
    label="Cash drains"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    Draw [label="Undrawn committed\nlines drawn in full"];
    Miss [label="Loan repayments\ndo not arrive"];
    Trig [label="Downgrade triggers:\nextra collateral to post"];
    Margin [label="Margin calls on\nderivatives as markets move"];
    Dep [label="Uninsured and wholesale\ndeposits withdrawn"];
    Lines [label="Other banks cut\nor refuse to roll lines"];
  }

  subgraph cluster_buffer {
    label="The buffer that should absorb it"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    HQLA [label="Liquid asset buffer (HQLA)"];
    EncQ [label="Encumbrance and\neligibility data correct?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  }

  Ok [label="Buffer covers outflows;\ncontingency plan buys time", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Short [label="Buffer smaller than thought:\nemergency central bank funding", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];

  Event -> Borrowers;
  Event -> Bank;
  Borrowers -> Draw; Borrowers -> Miss;
  Bank -> Trig; Bank -> Margin; Bank -> Dep; Bank -> Lines;
  Margin -> HQLA; Dep -> HQLA; Lines -> HQLA;
  Draw -> HQLA; Miss -> HQLA; Trig -> HQLA;
  Draw -> Margin [style=invis]; Miss -> Dep [style=invis]; Trig -> Lines [style=invis];
  {rank=same; Draw; Miss; Trig;}
  {rank=same; Margin; Dep; Lines;}
  HQLA -> EncQ;
  EncQ -> Ok [label="yes"];
  EncQ -> Short [label="no"];
}
