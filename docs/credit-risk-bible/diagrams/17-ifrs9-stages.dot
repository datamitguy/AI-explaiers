digraph IFRS9Stages {
  graph [rankdir=LR, splines=true, nodesep=0.4, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  New [label="Loan originated\n(not credit-impaired at purchase)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  S1 [label="Stage 1: performing\n12-month expected credit loss\ninterest on gross balance", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  S2 [label="Stage 2: significant increase\nin credit risk (SICR)\nLifetime expected credit loss\ninterest on gross balance", fillcolor="#d97706", fontcolor="white", color="#d97706"];
  S3 [label="Stage 3: credit-impaired\n(defaulted, 90 days or unlikely to pay)\nLifetime expected credit loss\ninterest on net balance", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];

  subgraph cluster_sicr {
    label="Typical SICR tests (any one triggers)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    T1 [label="Lifetime PD now more than\nX times origination PD\n(relative test)"];
    T2 [label="Absolute PD above a threshold\nor rating below a grade"];
    T3 [label="30 days past due backstop"];
    T4 [label="Qualitative: watchlist,\nforbearance, sector flag"];
  }

  New -> S1;
  S1 -> S2 [label=" SICR"];
  S2 -> S1 [label=" SICR reverses\n (after cure period)"];
  S2 -> S3 [label=" default"];
  S1 -> S3 [label=" straight to default"];
  S3 -> S2 [label=" cure, probation"];
  {T1 T2 T3 T4} -> S2 [style=dashed];
}
