digraph RatioFamilies {
  graph [rankdir=LR, splines=true, nodesep=0.3, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", pad=0.2, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Root [label="Can the borrower repay?\nFive ratio families answer five questions", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Lev [label="Leverage\nHow much debt relative to earnings\nor to the owners' money?", fillcolor="#fef3c7", color="#d97706"];
  Cov [label="Coverage\nDo earnings or cash cover the\ninterest and repayments?", fillcolor="#fef3c7", color="#d97706"];
  Liq [label="Liquidity\nCan it pay bills due in the\nnext twelve months?", fillcolor="#fef3c7", color="#d97706"];
  Prof [label="Profitability\nDoes the business actually\nmake money?", fillcolor="#fef3c7", color="#d97706"];
  WC  [label="Working capital efficiency\nHow long is cash tied up in\nstock and unpaid invoices?", fillcolor="#fef3c7", color="#d97706"];

  Lev1 [label="Net debt / EBITDA\n(example 2.3x; worry above 4x\nfor an ordinary company)"];
  Lev2 [label="Gearing = debt / equity\n(example 1.6x) or\ndebt / (debt + equity)"];
  Cov1 [label="Interest cover = EBIT / interest\n(example 5.5x; worry below 2x)"];
  Cov2 [label="Debt service coverage ratio\n= cash available / (interest + principal)\n(example 2.7x; worry below 1.2x)"];
  Cov3 [label="Fixed charge cover\n= (EBIT + rent) / (interest + rent)"];
  Liq1 [label="Current ratio = current assets\n/ current liabilities (example 1.7x)"];
  Liq2 [label="Quick ratio: the same but\nwithout stock (example 1.1x)"];
  Prof1 [label="Margins: gross, EBITDA, net\n(example EBITDA margin 15%)"];
  Prof2 [label="Return on assets, return on\ncapital employed (example ROA 9%)"];
  WC1  [label="Debtor days, stock days,\ncreditor days, cash conversion cycle\n(example 73 days)"];

  Root -> {Lev Cov Liq Prof WC};
  Lev -> {Lev1 Lev2};
  Cov -> {Cov1 Cov2 Cov3};
  Liq -> {Liq1 Liq2};
  Prof -> {Prof1 Prof2};
  WC -> WC1;
}
