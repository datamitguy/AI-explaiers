digraph ReferenceArchitecture {
  graph [rankdir=TB, splines=true, nodesep=0.25, ranksep=0.35, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2, compound=true];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.14,0.07"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  subgraph cluster_src {
    label="1. Sources"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    S1 [label="Origination,\ncore banking", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
    S2 [label="Collateral,\nlimits", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
    S3 [label="Treasury and\ntrading", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
    S4 [label="General ledger,\nexternal data", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
    S1 -> S2 -> S3 -> S4 [style=invis];
  }
  Ing [label="2. Ingestion\nfile loads, change data capture,\nAPIs, landing checks"];
  MDM [label="4. Reference and master data\nparty, product, FX,\ncountry, hierarchy", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  subgraph cluster_dp {
    label="3. Data platform"; labeljust=l; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    Raw [label="Raw zone\nexact copy\nof source"];
    Conf [label="Conformed zone\none model,\nmapped keys"];
    Cur [label="Curated zone\nmonth-end\nsnapshots"];
    Raw -> Conf -> Cur;
  }

  subgraph cluster_eng {
    label="5. Calculation engines"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    E1 [label="Ratings\nand scoring"];
    E2 [label="Exposure\n(incl. derivatives)"];
    E3 [label="Limits"];
    E4 [label="ECL\n(provisions)"];
    E5 [label="RWA\n(capital)"];
    E6 [label="Stress\ntesting"];
    E1 -> E2 -> E3 [style=invis];
    E4 -> E5 -> E6 [style=invis];
    E1 -> E4 [style=invis]; E2 -> E5 [style=invis]; E3 -> E6 [style=invis];
  }
  Orch [label="6. Orchestration\nscheduler, dependencies,\nrun calendar", fillcolor="#fef3c7", color="#d97706"];
  Res [label="7. Results store\nversioned outputs\nby as-of date and run"];
  Ctl [label="9. Controls layer\nreconciliation, data quality,\nlineage, audit, access", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Rep [label="8. Reporting and regulatory\nsubmission\nMI, returns, disclosures", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  {rank=same; S1 S2 S3 S4}
  {rank=same; Ing MDM}
  {rank=same; Raw Conf Cur}
  {rank=same; E1 E2 E3}
  {rank=same; E4 E5 E6}
  {rank=same; Res Orch}
  {rank=same; Rep Ctl}

  S2 -> Ing [ltail=cluster_src];
  Ing -> Raw [lhead=cluster_dp];
  MDM -> Conf [label=" keys and codes"];
  Conf -> E2 [ltail=cluster_dp, lhead=cluster_eng];
  E5 -> Res [ltail=cluster_eng];
  Res -> Rep;
  Orch -> E6 [style=dashed, lhead=cluster_eng, label=" triggers\n runs"];
  Ctl -> Res [style=dashed, arrowhead=none, label=" checks\n every layer"];
}
