digraph AppetiteCascade {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Board [label="Board risk appetite statement\n'Keep CET1 above 12%, expected loss\nbelow 0.6% of loans, no sector above 15%'", fillcolor="#1f2937", fontcolor="white", color="#1f2937", fontsize=13];

  subgraph cluster_group {
    label="Group level metrics and limits"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    G1 [label="Portfolio limits\nexpected loss, RWA, concentration"];
    G2 [label="Sector and country limits\ne.g. commercial property max 15%"];
    G3 [label="Single-name and group limits\ntighter than the regulatory 25%"];
    { rank=same; G1 -> G2 -> G3 [style=invis]; }
  }

  subgraph cluster_div {
    label="Business division allocation"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    D1 [label="Corporate bank\nshare of sector limits"];
    D2 [label="Retail bank\nproduct and rating-grade limits"];
    D3 [label="Markets\ncounterparty and settlement limits"];
    { rank=same; D1 -> D2 -> D3 [style=invis]; }
  }

  subgraph cluster_desk {
    label="Desk and customer level"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    K1 [label="Customer facility limits\n(loaded in the limit system)"];
    K2 [label="Pre-deal check\nbefore any new drawing"];
    K1 -> K2;
  }

  Up [label="Utilisation reported upward\nmonthly, with breaches flagged", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Board -> {G1 G2 G3} [label=" cascaded by\n the risk function"];
  G2 -> {D1 D2};
  G3 -> {D1 D3};
  G1 -> D2;
  {D1 D2 D3} -> K1;
  K2 -> Up [style=dashed];
  Up -> Board [style=dashed, label=" reporting loop"];
}
