digraph CollateralAllocation {
  graph [rankdir=TB, splines=true, nodesep=0.5, ranksep=1.0, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.14,0.07"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  subgraph cluster_coll {
    label="Collateral items (what the bank holds)"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    C1 [label="C1 Debenture over\nreceivables and stock\nvalue 8.0m"];
    C2 [label="C2 Cash deposit\nvalue 2.0m"];
    C3 [label="C3 Warehouse mortgage\nvalue 6.0m"];
  }
  subgraph cluster_fac {
    label="Facilities of Northwind Logistics Ltd"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    F1 [label="F1 Revolving facility\nlimit 10.0m", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];
    F2 [label="F2 Term loan\n4.0m", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];
    F3 [label="F3 Overdraft\nlimit 1.0m", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];
  }
  S [label="Surplus 2.0m\nunallocated, available\nfor future lending", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  C1 -> F1 [label=" 4.5m"];
  C1 -> F2 [label=" 2.5m"];
  C1 -> F3 [label=" 1.0m"];
  C2 -> F1 [label=" 1.5m", color="#065f46", fontcolor="#065f46"];
  C2 -> F3 [label=" 0.5m", color="#065f46", fontcolor="#065f46"];
  C3 -> F2 [label=" 4.0m\n first charge"];
  C3 -> S [style=dashed, label=" 2.0m"];
}
