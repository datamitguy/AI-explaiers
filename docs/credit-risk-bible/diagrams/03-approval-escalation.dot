digraph ApprovalEscalation {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="Credit proposal submitted\n(amount, rating, product, security)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Q1 [label="Fits an automated\ndecision strategy?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Auto [label="Decision engine\nscorecard plus policy rules\n(retail and small SME)", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Q2 [label="Within the relationship\nmanager's own authority?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  RM [label="Approved by first line\n(small, low-risk, standard terms)\nsampled by credit risk afterwards", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Q3 [label="Within a credit officer's\ndelegated authority?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  CO [label="Credit officer sanctions\n(second line, independent)\nlimit set by amount x rating grid", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Q4 [label="Within regional or\ndivisional committee authority?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  RCC [label="Divisional credit committee\nseveral senior sanctioners,\nminuted decision", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  GCC [label="Group credit committee\nor board risk committee\nlargest, riskiest, policy exceptions", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Cond [label="Any approver may decline\nor approve with conditions:\nmore security, lower amount,\nshorter tenor, higher price", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];

  Start -> Q1;
  Q1 -> Auto [label=" yes"];
  Q1 -> Q2 [label=" no"];
  Q2 -> RM [label=" yes"];
  Q2 -> Q3 [label=" no, escalate"];
  Q3 -> CO [label=" yes"];
  Q3 -> Q4 [label=" no, escalate"];
  Q4 -> RCC [label=" yes"];
  Q4 -> GCC [label=" no, escalate"];
  {CO RCC GCC} -> Cond [style=dashed];
}
