digraph SyndicatedLoan {
  graph [rankdir=TB, splines=true, ordering=out, nodesep=0.35, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Borrower [label="Borrower\n(e.g. a large manufacturer\nneeding 500 million)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_lead {
    label="Lead roles (usually one or two banks)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    MLA   [label="Mandated lead arranger (MLA)\nwins the mandate, structures\nthe deal, underwrites or\n'best efforts', sells it down"];
    Agent [label="Facility agent\nadministers the loan after signing:\ncollects payments, passes notices,\nruns lender votes"];
    SecAg [label="Security agent / trustee\nholds the collateral on behalf\nof all lenders"];
    { rank=same; MLA -> Agent -> SecAg [style=invis]; }
  }

  subgraph cluster_parts {
    label="Participants (the syndicate), each holds a share"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    P1 [label="Bank A\n100 million (also MLA)"];
    P2 [label="Bank B\n100 million"];
    P3 [label="Bank C\n75 million"];
    P4 [label="Bank D\n75 million"];
    P5 [label="Funds and insurers\n150 million (secondary buyers)"];
    { rank=same; P1 -> P2 -> P3 -> P4 -> P5 [style=invis]; }
  }

  Docs [label="One facility agreement (often LMA or\nLSTA standard form), one set of covenants,\nmajority-lender voting (e.g. 66.7%)", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  Borrower -> MLA [label=" mandate letter,\n term sheet"];
  MLA -> P1 [style=dashed];
  MLA -> P2 [style=dashed];
  MLA -> P3 [label=" information memorandum,\n invitation to join", style=dashed];
  MLA -> P4 [style=dashed];
  MLA -> P5 [style=dashed];
  P1 -> Agent; P2 -> Agent;
  P3 -> Agent [label=" each lender funds\n its share via the agent"];
  P4 -> Agent; P5 -> Agent;
  Agent -> Borrower [label=" single drawdown,\n single point of contact"];
  Borrower -> Agent [label=" interest and\n repayments"];
  Borrower -> SecAg [label=" pledges assets"];
  Agent -> Docs [style=dashed, dir=none];
}
