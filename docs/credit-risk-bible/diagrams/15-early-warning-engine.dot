digraph EarlyWarningEngine {
  graph [rankdir=TB, splines=true, nodesep=0.3, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  subgraph cluster_fin {
    label="Financial signals"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    F1 [label="Spread financial statements\n(margins, leverage, cover)"];
    F2 [label="Late or qualified accounts"];
    F3 [label="Covenant headroom"];
  }

  subgraph cluster_beh {
    label="Behavioural signals (the bank's own data)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    B1 [label="Overdraft excesses,\nlimit hugging"];
    B2 [label="Missed or late payments,\nbounced cheques, returned debits"];
    B3 [label="Change in account turnover"];
  }

  subgraph cluster_ext {
    label="External signals"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    E1 [label="Rating downgrades,\ncredit bureau alerts"];
    E2 [label="News, court filings,\ndirector changes"];
    E3 [label="Share price, CDS spread,\nsector stress indices"];
  }

  Engine [label="Trigger engine\nrules and scores: each signal\nhas a threshold and a weight", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a", fontsize=13];
  Case [label="Case created\nassigned to the relationship\nmanager and credit officer"];
  Q [label="Assessment within\nthe agreed days", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  False [label="False alarm: closed\nwith a reason code", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Watch [label="Added to the watchlist\nwith a category and action plan", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  IFRS [label="Feeds the IFRS 9\nstage 2 assessment", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  F1 -> F2 -> F3 [style=invis];
  B1 -> B2 -> B3 [style=invis];
  E1 -> E2 -> E3 [style=invis];
  {F3 B3 E3} -> Engine [lhead=""];
  { rank=same; False; Watch; }
  Engine -> Case -> Q;
  Q -> False [label=" no real\n deterioration"];
  Q -> Watch [label=" real\n deterioration"];
  Watch -> IFRS [style=dashed];
}
