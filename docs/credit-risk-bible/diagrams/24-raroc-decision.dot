digraph RarocDecision {
  graph [rankdir=LR, splines=true, nodesep=0.3, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  subgraph cluster_in {
    label="Inputs"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Rev [label="Revenue\nnet interest margin\nplus fees"];
    Cost [label="Minus operating cost"];
    ELn [label="Minus expected loss\nPD x LGD x EAD"];
    Tax [label="Minus tax"];
    Capn [label="Divided by capital\neconomic or regulatory,\nwhichever the bank uses"];
  }

  RAROC [label="RAROC\nrisk-adjusted return on capital", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];
  Q [label="RAROC above\nhurdle rate\n(say 12%)?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Yes [label="Creates value\napprove, allocate capital", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Rel [label="Below hurdle on its own\nbut relationship total\nclears it?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Exc [label="Approve as documented\nrelationship exception\nwith a review date"];
  No  [label="Destroys value\nreprice or decline", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];

  {Rev Cost ELn Tax Capn} -> RAROC;
  RAROC -> Q;
  Q -> Yes [label=" yes"];
  Q -> Rel [label=" no"];
  Rel -> Exc [label=" yes"];
  Rel -> No  [label=" no"];
}
