digraph VaultMap {
  graph [rankdir=TB, splines=true, nodesep=0.3, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=11, margin="0.15,0.08"];
  edge  [color="#4b5563", arrowsize=0.7];

  Start [label="00 Start Here", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_a { label="Foundations"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    N01 [label="01 What a Bank Is"]; N02 [label="02 What Credit Risk Is"]; N03 [label="03 The Credit Lifecycle"];
  }
  subgraph cluster_b { label="Products and lending"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    N04 [label="04 Commercial and\nCorporate Lending"]; N05 [label="05 Retail Lending"];
    N06 [label="06 Specialised Finance"]; N07 [label="07 Leveraged and\nAcquisition Finance"]; N08 [label="08 Trade Finance\nand Guarantees"];
  }
  subgraph cluster_c { label="Assessing and securing"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    N09 [label="09 Credit Analysis"]; N10 [label="10 Ratings, Scorecards\nand PD Models"];
    N11 [label="11 Collateral and Security"]; N12 [label="12 Documentation\nand Covenants"];
  }
  subgraph cluster_d { label="Governing and watching"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    N13 [label="13 Credit Governance"]; N14 [label="14 Risk Appetite\nand Limits"];
    N15 [label="15 Monitoring and\nEarly Warning"]; N16 [label="16 Problem Loans\nand Recovery"];
  }
  subgraph cluster_e { label="Measuring: accounting and capital"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    N17 [label="17 Provisioning\nIFRS 9 and CECL"]; N18 [label="18 Regulatory Capital\nand Basel"];
    N19 [label="19 Counterparty Credit\nRisk and Derivatives"]; N20 [label="20 Stress Testing\nand ICAAP"];
    Basel [label="Basel decision tree\nand long explainer", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];
  }
  subgraph cluster_f { label="Running the platform"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    N21 [label="21 Model Risk\nand Validation"]; N22 [label="22 Data, Systems\nand BCBS 239"];
    N23 [label="23 Reporting"]; N24 [label="24 Pricing and RAROC"];
  }
  subgraph cluster_g { label="Wider risks"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    N25 [label="25 Climate, ESG and\nEmerging Risks"]; N26 [label="26 Sovereign, Bank\nand Country Risk"]; N29 [label="29 Market Risk"];
  }
  N27 [label="27 A Platform Lead's\nFirst 90 Days", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  N28 [label="28 Master Glossary", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  Start -> N01 -> N02 -> N03;
  N03 -> N04; N03 -> N09; N03 -> N13;
  N04 -> N05 -> N06 -> N07 -> N08 [style=invis];
  N09 -> N10 -> N11 -> N12 [style=invis];
  N13 -> N14 -> N15 -> N16 [style=invis];
  N08 -> N17 [style=invis]; N12 -> N17 [style=invis]; N16 -> N17;
  N17 -> N18 -> N19 -> N20 [style=invis];
  N18 -> Basel;
  N20 -> N21 [style=invis];
  N21 -> N22 -> N23 -> N24 [style=invis];
  N24 -> N25 -> N26 -> N29 [style=invis];
  N22 -> N27;
  N29 -> N28 [style=invis];
}
