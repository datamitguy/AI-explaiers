digraph SACCR {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.45, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="All trades with one counterparty\nunder one netting agreement", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_rc {
    label="Replacement cost (RC)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    MTM [label="Sum the mark-to-market\nof all trades in the netting set"];
    Coll [label="Subtract collateral held\n(variation margin, independent amounts)"];
    RC [label="RC = max(net MTM minus collateral, 0)\nplus threshold and MTA terms if margined"];
    MTM -> Coll -> RC;
  }

  subgraph cluster_pfe {
    label="Potential future exposure (PFE)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Cls [label="Sort trades into asset classes\ninterest rate, FX, credit,\nequity, commodity"];
    AddOn [label="Add-on per class\nnotional x supervisory factor\nx maturity factor, netted within\nhedging sets"];
    Mult [label="Multiplier\nreduces PFE when the set is\nover-collateralised or out of the money"];
    PFE [label="PFE = multiplier x sum of add-ons"];
    Cls -> AddOn -> Mult -> PFE;
  }

  EAD [label="EAD = 1.4 x (RC + PFE)\nthen risk-weight by counterparty class", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];

  Start -> MTM;
  Start -> Cls;
  RC -> EAD;
  PFE -> EAD;
}
