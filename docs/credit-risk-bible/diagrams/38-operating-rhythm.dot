digraph Rhythm {
  graph [rankdir=TB, splines=true, nodesep=0.3, ranksep=0.35, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  subgraph cluster_d {
    label="Daily"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    D1 [label="Overnight batch\nand feed checks"];
    D2 [label="Limit, exposure and\nliquidity data delivered"];
    D3 [label="Incident triage\n(severity matrix)"];
  }
  subgraph cluster_w {
    label="Weekly"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    W1 [label="Data quality review\n(scorecard, break log)"];
    W2 [label="Change advisory board\n(change requests)"];
    W3 [label="Stakeholder\nstatus update"];
  }
  subgraph cluster_m {
    label="Monthly"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    M1 [label="Month-end ECL\nand RWA runs"];
    M2 [label="Metrics review\nand vendor reviews"];
    M3 [label="Steering committee\npack"];
  }
  subgraph cluster_q {
    label="Quarterly"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    Q1 [label="Quarter-end run\n(runbook, T-5 to T+10)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
    Q2 [label="Regulatory returns\nand impairment committee"];
    Q3 [label="EUC attestation\nand access review"];
  }
  subgraph cluster_a {
    label="Annual"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    A1 [label="Stress test and\nICAAP runs"];
    A2 [label="Model reviews,\naudit, resilience tests"];
    A3 [label="Budget, roadmap,\nvendor contracts"];
  }

  D1 -> D2 -> D3 [style=invis];
  W1 -> W2 -> W3 [style=invis];
  M1 -> M2 -> M3 [style=invis];
  Q1 -> Q2 -> Q3 [style=invis];
  A1 -> A2 -> A3 [style=invis];
  {rank=same; D1; D2; D3;}
  {rank=same; W1; W2; W3;}
  {rank=same; M1; M2; M3;}
  {rank=same; Q1; Q2; Q3;}
  {rank=same; A1; A2; A3;}

  D1 -> W1 -> M1 -> Q1 -> A1 [style=invis, weight=10];
  D3 -> W3 -> M3 -> Q3 -> A3 [style=invis, weight=10];
  D2 -> W2 [label="issues feed", weight=10];
  W2 -> M2 [label="rolls up into", weight=10];
  M2 -> Q2 [label="builds to", weight=10];
  Q2 -> A2 [label="builds towards", weight=10];
}
