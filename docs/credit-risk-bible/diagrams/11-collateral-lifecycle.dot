digraph CollateralLifecycle {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="Loan approved\nsubject to security", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_take {
    label="1. Take"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Take1 [label="Identify the asset and\nconfirm the borrower owns it"];
    Take2 [label="Sign the security document\n(mortgage, charge, pledge, assignment)"];
    Take1 -> Take2;
  }

  subgraph cluster_perfect {
    label="2. Perfect"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Perf1 [label="Register at the right registry\n(land, company, ship, aircraft)"];
    Perf2 [label="Confirm priority and ranking\nagainst other creditors"];
    Perf1 -> Perf2;
  }

  subgraph cluster_value {
    label="3. Value"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Val1 [label="Independent valuation:\nmarket value and forced-sale value"];
    Val2 [label="Apply haircut and\nallocate value to facilities"];
    Val1 -> Val2;
  }

  subgraph cluster_monitor {
    label="4. Monitor"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Mon1 [label="Revalue on schedule\nand on trigger events"];
    Q    [label="Cover still above\nthe minimum?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
    Margin [label="Margin call: borrower tops up\nor bank reduces the loan"];
    { rank=same; Mon1 -> Q; }
    Q -> Margin [label=" no"];
    Margin -> Mon1 [constraint=false];
  }

  subgraph cluster_end {
    label="5. Release or enforce"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Release [label="Loan repaid:\nrelease the security", fillcolor="#065f46", fontcolor="white", color="#065f46"];
    Enforce [label="Borrower defaults:\nenforce, sell, apply proceeds", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
    { rank=same; Release; Enforce; }
  }

  Start -> Take1;
  Take2 -> Perf1;
  Perf2 -> Val1;
  Val2 -> Mon1;
  Q -> Release [label=" yes, and loan repaid"];
  Q -> Enforce [label=" yes, but borrower defaults"];
}
