digraph PolicyHierarchy {
  graph [rankdir=TB, splines=true, nodesep=0.4, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Reg [label="Laws and regulation\n(Basel rules as adopted locally,\nsupervisor's expectations)", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  RAS [label="Risk appetite statement\n(board: how much risk, in numbers)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Frame [label="Credit risk management framework\n(board-approved: roles, principles,\nthree lines, governance bodies)"];
  Policy [label="Credit policies\n(group credit committee: what we lend,\nto whom, on what terms, who approves)"];
  Std [label="Credit standards and\nlending guidelines\n(by product, sector, country:\nmaximum LTV, minimum cover, tenor)"];
  Proc [label="Procedures and manuals\n(how to do it: forms, systems,\nchecklists, step by step)"];
  Sys [label="System rules and controls\n(limits, workflows, mandatory fields,\nautomated checks)", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Exc [label="Policy exception\n(approved and tracked,\nreported to committee)", fillcolor="#fef3c7", color="#d97706"];

  Reg -> RAS [label=" constrains"];
  RAS -> Frame;
  Frame -> Policy;
  Policy -> Std;
  Std -> Proc;
  Proc -> Sys [label=" encoded in"];
  Policy -> Exc [label=" deviation from", style=dashed];
  Std -> Exc [style=dashed];
}
