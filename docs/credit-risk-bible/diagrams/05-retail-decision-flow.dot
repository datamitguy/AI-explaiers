digraph RetailDecisionFlow {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="Customer applies\n(app, web, branch, broker, point of sale)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_data {
    label="Data gathered in seconds"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Form   [label="Application data\nincome, employment, address,\nrequested amount"];
    Bureau [label="Credit bureau pull\nexisting debts, missed payments,\nsearches, bureau score"];
    Intern [label="Internal data\nexisting accounts, transaction\nhistory, behavioural score"];
    IDV    [label="Identity, fraud and\nKYC / AML checks"];
    { rank=same; Form -> Bureau -> Intern -> IDV [style=invis]; }
  }

  Engine [label="Decision engine\n(strategy: policy rules, then scorecard,\nthen affordability, then limit assignment)", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];

  Q1 [label="Policy rule knock-out?\n(age, bankruptcy, fraud flag,\nsanctions hit)", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Q2 [label="Score above cut-off\nand affordable?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];

  Decline [label="Automatic decline\nreason code stored, adverse\naction notice where required", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Refer   [label="Refer to an underwriter\ngrey zone, missing data,\nhigh value, manual review"];
  Accept  [label="Automatic accept\nlimit, price and terms assigned\nby the strategy", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Book [label="Account opened on the core system\nscore, decision, reason codes and\nstrategy version stored for audit", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Start -> {Form Bureau Intern IDV};
  {Form Bureau Intern IDV} -> Engine;
  Engine -> Q1;
  Q1 -> Decline [label=" yes"];
  Q1 -> Q2 [label=" no"];
  Q2 -> Accept [label=" clear yes"];
  Q2 -> Refer [label=" borderline"];
  Q2 -> Decline [label=" clear no"];
  Refer -> Accept [label=" override up", style=dashed];
  Refer -> Decline [label=" override down", style=dashed];
  Accept -> Book;
}
