digraph Traceability {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.35, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Rule [label="Regulatory text\nfinal rule, paragraph 4.12(b)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Memo [label="Interpretation memo\nwhat the paragraph means for us\nREG-INT-031"];
  Sign [label="Interpretation\nsigned off?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  Esc [label="Escalate: regulatory policy,\nlegal, ask the regulator\nif truly ambiguous", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  BRD [label="Business requirements\nBR-07: apply 40% to commitments\ntraced to REG-INT-031"];
  FS [label="Functional specification\nFS-07.2: CCF lookup by\nproduct and cancellability flag"];
  Code [label="Code and configuration\nCCF table v3, commit and ticket"];
  Test [label="Test cases\nTC-07.2.1 to TC-07.2.9\nexpected results per case"];
  Ev [label="Evidence pack\nresults, parallel run, sign-offs"];
  Prod [label="Production\nnumber in the regulatory return", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  Rule -> Memo -> Sign;
  Sign -> Esc [label="no"];
  Esc -> Memo [style=dashed, label="revise"];
  Sign -> BRD [label="yes"];
  BRD -> FS -> Code -> Test -> Ev -> Prod;
  {rank=same; Sign Esc}

  Back [label="Traceability matrix\nany number can be followed\nback up to the paragraph", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  Prod -> Back [style=dashed];
  {rank=same; Prod Back}
}
