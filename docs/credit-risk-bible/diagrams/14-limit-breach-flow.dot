digraph LimitBreachFlow {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="Limit utilisation measured\n(pre-deal check or end-of-day run)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Q1 [label="Utilisation above\nthe limit?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Q2 [label="Above the early warning\nthreshold (e.g. 85%)?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Green [label="Green: no action,\nreport utilisation", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Amber [label="Amber: warn the business,\nno new exposure without\ncredit sign-off"];

  Q3 [label="Active breach (new deal) or\npassive breach (market move,\nrating change, FX)?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Active [label="Active breach: deal should have\nbeen blocked; incident raised,\nroot cause investigated", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Passive [label="Passive breach: record,\nexplain cause, propose plan"];

  Esc [label="Escalate to the limit owner\nwithin agreed hours or days"];
  Decide [label="Limit owner decides", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Reduce [label="Reduce exposure\n(sell down, hedge, let it run off)"];
  Temp [label="Temporary excess approved\nwith expiry date"];
  Raise [label="Raise the limit\n(needs the next level up)"];
  Report [label="All breaches reported to\nrisk committee monthly\nand to the board quarterly", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];

  Start -> Q1;
  Q1 -> Q2 [label=" no"];
  Q2 -> Green [label=" no"];
  Q2 -> Amber [label=" yes"];
  Q1 -> Q3 [label=" yes"];
  Q3 -> Active [label=" active"];
  Q3 -> Passive [label=" passive"];
  {Active Passive} -> Esc -> Decide;
  Decide -> {Reduce Temp Raise};
  {Reduce Temp Raise Amber} -> Report;
}
