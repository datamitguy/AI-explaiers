digraph BaselMap {
  graph [rankdir=LR, splines=true, nodesep=0.25, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Root [label="Basel III consolidated framework", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_cre {
    label="CRE: credit risk"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    CRE20 [label="CRE20 to CRE22\nStandardised approach\nand credit risk mitigation"];
    CRE30 [label="CRE30 to CRE36\nInternal ratings-based\napproach"];
    CRE40 [label="CRE40 to CRE45\nSecuritisation"];
    CRE50 [label="CRE50 to CRE54\nCounterparty credit risk\n(SA-CCR, IMM, CCPs)"];
    CRE60 [label="CRE60 Equity in funds\nCRE70 Settlement risk"];
  }

  subgraph cluster_other {
    label="Other chapters"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    RBC [label="RBC: risk-based capital\nminimums, buffers,\noutput floor"];
    CAP [label="CAP: definition of capital\nwhat counts as CET1,\nAT1, Tier 2"];
    LEV [label="LEV: leverage ratio"];
    LEX [label="LEX: large exposures"];
    MAR [label="MAR: market risk\nincluding CVA (MAR50)", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    OPE [label="OPE: operational risk", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    LCR [label="LCR and NSF: liquidity", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    SRP [label="SRP: supervisory review\n(Pillar 2, ICAAP)"];
    DIS [label="DIS: disclosure\n(Pillar 3)"];
  }

  Root -> {CRE20 CRE30 CRE40 CRE50 CRE60};
  Root -> {RBC CAP LEV LEX MAR OPE LCR SRP DIS};
}
