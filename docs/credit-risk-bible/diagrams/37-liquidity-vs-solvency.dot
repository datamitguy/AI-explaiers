digraph LiqSolv {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.4, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="A bank on any given day", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Q1 [label="Solvency: do assets\nexceed liabilities?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  Q2a [label="Liquidity: enough cash\nfor what falls due?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  Q2b [label="Liquidity: enough cash\nfor what falls due?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];

  Healthy [label="Solvent and liquid\nbusiness as usual", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Illiquid [label="Solvent but illiquid\ncentral bank can lend\nagainst good collateral"];
  Zombie [label="Insolvent but liquid\nlooks fine until losses\nare recognised"];
  Dead [label="Insolvent and illiquid\nresolution or rescue", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];

  subgraph cluster_loop {
    label="The doom loop"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    Fire [label="Fire sales of assets\nat a discount"];
    Loss [label="Losses eat capital"];
    Rumour [label="Rumours of losses\nor a rating downgrade"];
    Run [label="Depositors and lenders\nwithdraw: a run"];
  }

  Start -> Q1;
  Q1 -> Q2a [label="yes"];
  Q1 -> Q2b [label="no"];
  Q2a -> Healthy [label="yes"];
  Q2a -> Illiquid [label="no"];
  Q2b -> Zombie [label="yes"];
  Q2b -> Dead [label="no"];

  Illiquid -> Fire [style=dashed];
  Zombie -> Rumour [style=dashed];
  Fire -> Loss -> Rumour -> Run -> Fire;
  Run -> Dead [style=dashed, color="#991b1b"];
}
