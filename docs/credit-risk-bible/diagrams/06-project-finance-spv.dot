digraph ProjectFinanceSPV {
  graph [rankdir=TB, splines=true, nodesep=0.4, ranksep=0.55, fontname="Helvetica", fontsize=13, bgcolor="white", pad=0.2, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  subgraph cluster_equity {
    label="Equity side (own the project)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Sponsors [label="Sponsors\n(developer, utility, infrastructure fund)\nput in equity, typically 20% to 40%"];
  }

  subgraph cluster_debt {
    label="Debt side (lend to the project)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Lenders [label="Lenders\n(bank syndicate, bond investors,\nexport credit agencies, development banks)"];
    Agent   [label="Facility and security agent\n(one bank acts for all lenders)"];
    Lenders -> Agent [label=" appoint"];
  }

  SPV [label="Project company (SPV)\nSpecial purpose vehicle\nowns the asset, signs every contract,\nhas no other business", fillcolor="#1f2937", fontcolor="white", color="#1f2937", fontsize=13];

  subgraph cluster_contracts {
    label="Contract parties (do the work and buy the output)"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    EPC   [label="EPC contractor\n(engineering, procurement, construction)\nbuilds it for a fixed price and date"];
    OM    [label="O&M contractor\n(operations and maintenance)\nruns it once built"];
    Off   [label="Offtaker\n(buys the output under a long\ncontract, e.g. a power purchase agreement)"];
    Supply [label="Fuel or input supplier\n(long-term supply agreement)"];
    { rank=same; EPC; OM; }
    { rank=same; Off; Supply; }
    EPC -> Off [style=invis]; OM -> Supply [style=invis];
  }

  subgraph cluster_public {
    label="Public and insurance"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Host   [label="Host government\n(permits, concession, sometimes guarantees)"];
    Ins    [label="Insurers\n(construction all-risks, business interruption)"];
    { rank=same; Host; Ins; }
  }
  Off -> Host [style=invis]; Supply -> Ins [style=invis];

  Sponsors -> SPV [label=" equity and\n shareholder loans"];
  Agent    -> SPV [label=" senior debt,\n typically 60% to 80%"];
  SPV      -> Agent [label=" debt service, security\n over all assets and contracts", style=dashed];
  SPV      -> EPC  [label=" construction contract"];
  SPV      -> OM   [label=" O&M contract"];
  SPV -> Off [dir=back, label=" revenue for output"];
  SPV -> Supply [dir=back, label=" inputs"];
  SPV -> Host [dir=back, label=" licence or concession", constraint=false];
  SPV -> Ins [dir=back, label=" cover", constraint=false];
  Agent    -> EPC  [label=" direct agreement:\n step-in rights", style=dashed, color="#991b1b", fontcolor="#991b1b"];
  Agent    -> Off  [label=" direct agreement:\n step-in rights", style=dashed, color="#991b1b", fontcolor="#991b1b"];
}
