digraph AnnualCalendar {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.35, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  YE [label="Year-end (December reporting date)\nchange freeze, year-end run,\nannual accounts and external audit", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Q1 [label="January to March\nQ4 returns, annual Pillar 3,\nICAAP drafting, stress test launch"];
  Q2 [label="April to June\nICAAP to board and supervisor,\nstress test runs and submissions,\nQ1 returns"];
  Q3 [label="July to September\nsupervisory review (SREP) feedback,\nhalf-year results, Q2 returns,\nmain release window for big change"];
  Q4 [label="October to December\nbudget and capital plan,\nQ3 returns, model recalibrations,\naudit plan for next year"];
  Every [label="Every month and quarter\nmonth-end ECL and RWA runs,\nquarterly returns about 4 to 6\nweeks after each quarter end", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  YE -> Q1 -> Q2 -> Q3 -> Q4;
  Q4:e -> YE:e [constraint=false, label="  the cycle\n  repeats", style=dashed];
  Q4 -> Every [style=invis];
}
