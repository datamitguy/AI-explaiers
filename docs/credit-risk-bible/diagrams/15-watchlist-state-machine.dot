digraph WatchlistStates {
  graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Perf [label="Performing\nnormal annual review\nIFRS 9 stage 1", fillcolor="#065f46", fontcolor="white", color="#065f46"];

  subgraph cluster_watch {
    label="Watchlist (still performing, but closer attention)"; style="rounded,dashed"; color="#d97706"; fontcolor="#374151";
    W1 [label="Watch category 1 'monitor'\nquarterly review,\nusually still stage 1", fillcolor="#fef3c7", color="#d97706"];
    W2 [label="Watch category 2 'concern'\nmonthly review,\nIFRS 9 stage 2 likely", fillcolor="#fef3c7", color="#d97706"];
    W3 [label="Watch category 3 'intensive care'\nworkout team involved,\nstage 2 or 3", fillcolor="#fef3c7", color="#d97706"];
    W1 -> W2 [label=" worsens"];
    W2 -> W3 [label=" worsens"];
    W2 -> W1 [label=" improves"];
    W3 -> W2 [label=" improves"];
  }

  Forb [label="Forborne\nterms changed because of\nfinancial difficulty; flagged\nfor a probation period"];
  NPL [label="Non-performing / defaulted\n90 days past due or unlikely\nto pay; IFRS 9 stage 3", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Cure [label="Cured\nback to performing after\nprobation (often 12 months for\nnon-performing forborne)", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Loss [label="Loss\nwrite-off, sale,\nenforcement proceeds", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Perf -> W1 [label=" trigger"];
  W1 -> Perf [label=" resolved"];
  W2 -> Forb [label=" concession\n granted", style=dashed];
  W3 -> Forb [label=" concession\n granted", style=dashed];
  W3 -> NPL [label=" default"];
  Forb -> NPL [label=" fails again"];
  Perf -> NPL [label=" sudden default\n (fraud, shock)", style=dashed];
  NPL -> Cure [label=" pays, probation\n completed"];
  NPL -> Loss [label=" recovery\n exhausted"];
  Forb -> Cure [label=" performs through\n probation"];
  Cure -> Perf [style=dashed, constraint=false];
  { rank=same; Forb; NPL; }
  { rank=same; Cure; Loss; }
}
