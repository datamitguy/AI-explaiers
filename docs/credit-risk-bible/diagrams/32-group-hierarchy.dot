digraph GroupHierarchy {
  graph [rankdir=TB, splines=true, nodesep=0.3, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.14,0.07"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  subgraph cluster_group {
    label="Connected group for large exposures: 23.5m in total"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11;
    H [label="Northwind Holdings plc\nultimate parent, UK\nexposure 2.0m", fillcolor="#1e3a8a", fontcolor="white", color="#1e3a8a"];
    L [label="Northwind Logistics Ltd\nexposure 12.0m\n(three facilities)"];
    P [label="Northwind Property Ltd\nexposure 5.0m"];
    F [label="Northwind Freight GmbH\nGermany\nexposure 3.0m"];
    C [label="Coastal Packaging Ltd\nindependent owners,\n70% of sales to Logistics\nexposure 1.5m", fillcolor="#fef3c7", color="#d97706"];
  }
  A [label="Harbour Fuels Ltd\n30% associate, not controlled\nexposure 4.0m\n(own group)", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  H -> L [label=" owns 100%"];
  H -> P [label=" owns 75%"];
  L -> F [label=" owns 100%\n (H is ultimate parent)"];
  H -> A [label=" owns 30%", style=dashed];
  C -> L [label=" economic dependence\n (main customer)", style=dashed, color="#d97706"];
  H -> P [label=" guarantees\n P's loan", style=dashed, color="#065f46", fontcolor="#065f46", constraint=false];
}
