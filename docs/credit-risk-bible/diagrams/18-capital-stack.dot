digraph CapitalStack {
  graph [rankdir=TB, splines=true, nodesep=0.3, ranksep=0.3, fontname="Helvetica", fontsize=13, bgcolor="white", pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10", width=4.6];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Top  [label="Illustrative CET1 stack for one bank\n(as % of RWA, read from the bottom up)", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  MB   [label="Management buffer\n(bank's own headroom, e.g. 1.0%)\nset by the board, not a rule", fillcolor="#d1fae5", color="#065f46"];
  P2B  [label="Pillar 2B / stress buffer\n(set from stress test results)\nsize varies by bank and country"];
  SYS  [label="Systemic buffer (G-SIB or D-SIB)\n1.0% to 3.5% for the largest banks"];
  CCyB [label="Countercyclical buffer\n0% to 2.5%, set by each country"];
  CCB  [label="Capital conservation buffer\n2.5% for everyone"];
  P2A  [label="Pillar 2A add-on\n(risks Pillar 1 misses, e.g. concentration)\nillustrative 1.5%"];
  Min  [label="Pillar 1 minimum CET1\n4.5% of RWA", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Line [label="Below the buffers: dividends and bonuses\nrestricted. Below the minimum: regulator\nintervenes, possibly resolution", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];

  Top -> MB -> P2B -> SYS -> CCyB -> CCB -> P2A -> Min -> Line;
}
