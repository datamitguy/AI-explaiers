digraph CLS {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.4, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Trade [label="Bank A and Bank B agree an FX trade\nA sells 10m pounds, B sells 12.5m dollars", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Submit [label="1. Both banks send settlement\ninstructions to CLS"];
  Match [label="2. CLS matches the two instructions\nand queues the trade for its value date"];
  Net [label="3. Before value date CLS nets each\nmember's trades per currency and sends\na pay-in schedule (much smaller amounts)"];
  PayIn [label="4. On value date members pay in through\ncentral bank payment systems,\nin a window when all are open"];
  Q [label="Both legs funded\nand risk tests\npassed?", shape=diamond, fillcolor="#fef3c7", color="#d97706"];
  Settle [label="5. CLS settles both legs at once\non its own books: pounds to B,\ndollars to A, in one instant", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Wait [label="Trade waits in the queue\nnobody has lost a principal leg", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  Fail [label="If a member fails:\nunsettled trades are returned,\nnot half-paid", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  PayOut [label="6. CLS pays out the net\nbalances to members", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Trade -> Submit -> Match -> Net -> PayIn -> Q;
  Q -> Settle [label="yes"];
  Q -> Wait [label="not yet"];
  Wait -> Q [style=dashed, label=" retried"];
  Wait -> Fail [style=dashed];
  Settle -> PayOut;
}
