digraph DelinquencyRollRates {
  graph [rankdir=TB, splines=true, nodesep=0.3, ranksep=0.6, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Cur [label="Current\n0 days past due\n100,000 accounts", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  B1  [label="Bucket 1\n1 to 30 days past due\n(illustrative: 3,000)"];
  B2  [label="Bucket 2\n31 to 60 days past due\n(illustrative: 900)"];
  B3  [label="Bucket 3\n61 to 90 days past due\n(illustrative: 540)"];
  Def [label="Default\n90+ days past due\n(illustrative: 432)", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  WO  [label="Charge-off / write-off\nafter 180 days (varies)\nsold or recovered", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Cur -> B1 [label=" roll forward 3%"];
  B1  -> B2 [label=" roll forward 30%"];
  B2  -> B3 [label=" roll forward 60%"];
  B3  -> Def [label=" roll forward 80%"];
  Def -> WO [label=" after recovery\n attempts"];

  B1 -> Cur [label=" cure 70%", style=dashed, color="#065f46", fontcolor="#065f46"];
  B2 -> Cur [label=" cure 40%", style=dashed, color="#065f46", fontcolor="#065f46"];
  B3 -> Cur [label=" cure 20%", style=dashed, color="#065f46", fontcolor="#065f46"];

  subgraph cluster_actions {
    label="Collections action by bucket"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Act1 [label="Soft: SMS, email,\napp nudge, self-serve plan", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    Act2 [label="Medium: phone calls,\nletters, payment arrangement", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    Act3 [label="Hard: formal notices,\nforbearance, vulnerability check", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
    Act4 [label="Recovery: agency placement,\nlitigation, debt sale", fillcolor="#6b7280", fontcolor="white", color="#6b7280"];
  }
  B1 -> Act1 [style=dotted];
  B2 -> Act2 [style=dotted];
  B3 -> Act3 [style=dotted];
  Def -> Act4 [style=dotted];
}
