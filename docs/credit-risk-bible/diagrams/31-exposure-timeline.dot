digraph ExposureTimeline {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.4, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.16,0.08"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Trade [label="Trade date (T)\ndeal agreed, nothing paid yet", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  subgraph cluster_pre {
    label="Pre-settlement risk: weeks, months or years"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11; labeljust=r;
    Life [label="Life of the contract\nmarkets move every day"];
    MTM [label="Exposure = replacement cost\npositive mark-to-market plus an\nadd-on for future moves"];
    Size1 [label="Size: a small fraction of notional\n(often a few per cent)", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  }

  subgraph cluster_set {
    label="Settlement risk: hours, sometimes days"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151"; fontsize=11; labeljust=r;
    Pay [label="Value date: we send our leg\npayment becomes irrevocable"];
    Window [label="Window of exposure\nour money has gone,\ntheirs has not yet arrived"];
    Size2 [label="Size: the full principal\n(100% of what we paid)", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  }

  Done [label="Receipt confirmed\nnostro reconciled, risk ends", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];

  Trade -> Life -> MTM -> Size1;
  Size1 -> Pay [label=" settlement date arrives"];
  Pay -> Window -> Size2 -> Done;
}
