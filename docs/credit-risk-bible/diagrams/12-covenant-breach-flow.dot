digraph CovenantBreachFlow {
  graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.5, fontname="Helvetica", fontsize=13, bgcolor="white", newrank=true, pad=0.2];
  node  [shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#6366f1", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge  [color="#4b5563", arrowsize=0.7, fontname="Helvetica", fontsize=10, fontcolor="#374151"];

  Start [label="Quarter end: test date", fillcolor="#1f2937", fontcolor="white", color="#1f2937"];
  Cert [label="Borrower delivers accounts and\ncompliance certificate\n(usually within 45 to 90 days)"];
  Calc [label="Bank recalculates each ratio\nfrom the definitions in the agreement"];
  Pass [label="All covenants met?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Ok   [label="Record result and headroom\nin the covenant system", fillcolor="#065f46", fontcolor="white", color="#065f46"];
  Tight [label="Headroom below\nwarning level?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];
  Watch [label="Flag to watchlist review\n(see note 15)"];

  Breach [label="Breach: event of default\n(after any cure period)", fillcolor="#991b1b", fontcolor="white", color="#991b1b"];
  Reserve [label="Reservation of rights letter\n(bank keeps its options open)"];
  Decide [label="What does the bank do?", shape=diamond, style=filled, fillcolor="#fef3c7", color="#d97706", margin="0.05,0.05"];

  subgraph cluster_options {
    label="Options, decided by credit committee"; style="rounded,dashed"; color="#9ca3af"; fontcolor="#374151";
    Waive [label="Waiver\n(forgive this test, often for a fee)"];
    Amend [label="Amendment and reset\n(new covenant levels, more margin,\nextra security, equity cure)"];
    Accel [label="Accelerate and enforce\n(demand repayment, call security)"];
    { rank=same; Waive -> Amend -> Accel [style=invis]; }
  }

  Start -> Cert -> Calc -> Pass;
  Pass -> Tight [label=" yes"];
  Tight -> Ok [label=" no"];
  Tight -> Watch [label=" yes"];
  Pass -> Breach [label=" no"];
  Breach -> Reserve -> Decide;
  Decide -> {Waive Amend Accel};
  Waive -> Watch;
  Amend -> Watch;
}
